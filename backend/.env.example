# 数据库配置（Docker 环境下 DB_HOST 应设为 mysql 容器名）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=werewolf
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=werewolf

# JWT 配置（双 token：access 短时 + refresh 长效）
JWT_SECRET=please_generate_a_strong_secret_key_using_node_crypto
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# 服务端口
PORT=3001

# 大模型 API：不在此处配置。
# 每个用户可在前端「设置」页填写自己的 API Key / Base URL / 模型名，
# 绑定到账号并保存到数据库，系统不内置任何默认模型。

# CORS 允许的源（逗号分隔，Docker 环境下应包含 http://localhost）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理员用户ID（逗号分隔，可选）
# 不配置时管理接口（/stats/sync、/stats/clear、/stats/ai）将禁用，仅自己创建的AI智能体可修改
# 获取方式：登录后访问 /api/stats/me 查看 user id，或查 users 表 id 字段
# ADMIN_USER_IDS=1,5
