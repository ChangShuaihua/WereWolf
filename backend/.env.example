# 数据库配置（Docker 环境下 DB_HOST 应设为 mysql 容器名）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=werewolf
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=werewolf

# JWT 配置
JWT_SECRET=please_generate_a_strong_secret_key_using_node_crypto
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3001

# AI API 配置（可选，不配置则使用 fallback 模板逻辑）
DEEPSEEK_API_KEY=your_deepseek_api_key

# CORS 允许的源（逗号分隔，Docker 环境下应包含 http://localhost）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
