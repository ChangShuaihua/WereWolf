{
  "name": "werewolf-backend",
  "version": "1.0.0",
  "description": "Werewolf game backend - Node.js + Express + Socket.io",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "test": "node --test test/**/*.test.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,md}\""
  },
  "dependencies": {
    "@langchain/openai": "^1.5.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.3",
    "mysql2": "^3.11.0",
    "node-cache": "^5.1.2",
    "redis": "^4.7.1",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.0"
  }
}
